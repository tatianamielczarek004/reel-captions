{
  "name": "reel-captions",
  "version": "0.1.0",
  "description": "Animated word-by-word captions for vertical video (Reels, Shorts, TikTok), built with Remotion. Cues come from a simple JSON/TS list or an SRT file.",
  "license": "MIT",
  "private": false,
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Captions out/captions.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le",
    "srt": "node scripts/srt-to-cues.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.4.0"
  }
}
